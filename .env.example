# Meta Marketing API Credentials
# Get these from Meta for Developers (developers.facebook.com)
# App -> Marketing API -> Tools / Settings

META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v25.0

# Optional: Set to 'true' to use realistic mock data when no Meta credentials are provided
USE_MOCK_DATA=true
